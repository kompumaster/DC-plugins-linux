#!/bin/sh
# DC-plugins-linux deterministic pre-commit gate (Tier 1).
#
# 1. leak-guard — always
# 2. build + ELF/ABI — only when a plugin's native source is staged
#
# Enable once per clone:  git config core.hooksPath .githooks
# Emergency skip:         git commit --no-verify
set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

echo "[pre-commit] leak-guard"
sh scripts/leak-guard.sh

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# --- markdown-wlx ---------------------------------------------------
if printf '%s\n' "$staged" | grep -qE '^markdown-wlx/(MarkdownView\.cpp|listplug\.h|build\.sh)$'; then
    echo "[pre-commit] markdown-wlx source staged -> building"
    ( cd markdown-wlx && ./build.sh >/dev/null )
    wlx="markdown-wlx/build/MarkdownView.wlx"
    info=$(file "$wlx")
    case "$info" in
        *ELF*shared\ object* | *ELF*pie\ executable*) ;;
        *) echo "[pre-commit] FAIL: not an ELF shared object -> $info"; exit 1 ;;
    esac
    for sym in ListLoad ListLoadW ListLoadNext ListLoadNextW ListCloseWindow \
               ListGetDetectString ListSetDefaultParams ListSendCommand \
               ListSearchText ListSearchTextW; do
        nm -D --defined-only "$wlx" | grep -q " T $sym$" \
            || { echo "[pre-commit] FAIL: missing export $sym"; exit 1; }
    done
    echo "[pre-commit] markdown-wlx OK (ELF, all ABI exports present)"
fi

# --- media-info-wdx -------------------------------------------------
if printf '%s\n' "$staged" | grep -qE '^media-info-wdx/(MediaInfo\.cpp|contplug\.h|build\.sh)$'; then
    echo "[pre-commit] media-info-wdx source staged -> building"
    ( cd media-info-wdx && ./build.sh >/dev/null )
    wdx="media-info-wdx/build/MediaInfo.wdx"
    info=$(file "$wdx")
    case "$info" in
        *ELF*shared\ object* | *ELF*pie\ executable*) ;;
        *) echo "[pre-commit] FAIL: not an ELF shared object -> $info"; exit 1 ;;
    esac
    for sym in ContentGetSupportedField ContentGetValue ContentGetValueW \
               ContentGetSupportedFieldFlags ContentGetDetectString \
               ContentSetDefaultParams ContentPluginUnloading; do
        nm -D --defined-only "$wdx" | grep -q " T $sym$" \
            || { echo "[pre-commit] FAIL: missing export $sym"; exit 1; }
    done
    echo "[pre-commit] media-info-wdx OK (ELF, all ABI exports present)"
fi

# --- image-wlx ------------------------------------------------------
if printf '%s\n' "$staged" | grep -qE '^image-wlx/(ImageView\.cpp|listplug\.h|build\.sh)$'; then
    echo "[pre-commit] image-wlx source staged -> building"
    ( cd image-wlx && ./build.sh >/dev/null )
