        *ELF*shared\ object* | *ELF*pie\ executable*) ;;
        *) echo "[pre-commit] FAIL: not an ELF shared object -> $info"; exit 1 ;;
    esac
    for sym in ListLoad ListLoadW ListLoadNext ListLoadNextW ListCloseWindow \
               ListGetDetectString ListSetDefaultParams ListSendCommand; do
        nm -D --defined-only "$wlx" | grep -q " T $sym$" \
            || { echo "[pre-commit] FAIL: missing export $sym"; exit 1; }
    done
    echo "[pre-commit] image-wlx OK (ELF, all ABI exports present)"
fi

# --- book-wlx -------------------------------------------------------
if printf '%s\n' "$staged" | grep -qE '^book-wlx/(BookView\.cpp|zipreader\.[ch]|build\.sh)$'; then
    echo "[pre-commit] book-wlx source staged -> building"
    ( cd book-wlx && ./build.sh >/dev/null )
    wlx="book-wlx/build/BookView.wlx"
    info=$(file "$wlx")
    case "$info" in
        *ELF*shared\ object* | *ELF*pie\ executable*) ;;
        *) echo "[pre-commit] FAIL: not an ELF shared object -> $info"; exit 1 ;;
    esac
    for sym in ListLoad ListLoadW ListLoadNext ListLoadNextW ListCloseWindow \
               ListGetDetectString ListSetDefaultParams ListSendCommand \
               ListSearchText ListSearchTextW; do
        nm -D --defined-only "$wlx" | grep -q " T $sym$" \
            || { echo "[pre-commit] FAIL: missing export $sym"; exit 1; }
    done
    echo "[pre-commit] book-wlx OK (ELF, all ABI exports present)"
fi

echo "[pre-commit] passed"
